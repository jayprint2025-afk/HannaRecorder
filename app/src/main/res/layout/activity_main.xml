<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="24dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Hanna Recorder" android:textSize="28sp" android:textStyle="bold"/>
    <TextView android:id="@+id/progress" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:textSize="16sp"/>
    <TextView android:id="@+id/kind" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="18dp" android:textStyle="bold"/>
    <TextView android:id="@+id/prompt" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center" android:padding="24dp" android:textSize="32sp" android:textStyle="bold"/>
    <TextView android:id="@+id/tip" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <Button android:id="@+id/record" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="18dp" android:text="Grabar"/>
    <Button android:id="@+id/play" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Escuchar"/>
    <Button android:id="@+id/accept" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Guardar y continuar"/>
    <Button android:id="@+id/retry" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Repetir"/>
    <Button android:id="@+id/export" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Compartir ZIP por WhatsApp"/>
</LinearLayout>
</ScrollView>